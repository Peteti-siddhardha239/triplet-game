# Environment variables for Time Trotter
# Copy this file to .env and fill in the values

# Server
PORT=3000
NODE_ENV=development

# JWT Secrets (generate strong random strings for production)
JWT_ACCESS_SECRET=time-trotter-access-secret-change-me-in-prod
JWT_REFRESH_SECRET=time-trotter-refresh-secret-change-me-in-prod
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Database
DB_PATH=./data/timetrotter.db

# Email (SMTP) — defaults to Ethereal (free test account, no real emails sent)
# Set SMTP_USE_ETHEREAL=false and fill SMTP_* below to send real emails
SMTP_USE_ETHEREAL=true

# Gmail SMTP (only needed when SMTP_USE_ETHEREAL=false)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Time Trotter <your-gmail@gmail.com>

# Admin account (auto-created on first run if DB is empty)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@timetrotter.local
ADMIN_PASSWORD=Admin@12345

# Rate limiting
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MS=900000

# OTP
OTP_TTL_MINUTES=5
OTP_MAX_PER_HOUR=3
